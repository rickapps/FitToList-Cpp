{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (Qt's bundled MinGW + Ninja + CMake)",
      "binaryDir": "${sourceDir}/build",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "E:/Qt/6.11.2/mingw_64"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows (Visual Studio + MSVC Qt kit)",
      "binaryDir": "${sourceDir}/build-msvc",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "E:/Qt/6.11.2/msvc2022_64"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows", "configurePreset": "windows" },
    { "name": "windows-msvc", "configurePreset": "windows-msvc" }
  ],
  "testPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "output": { "outputOnFailure": true }
    }
  ]
}
